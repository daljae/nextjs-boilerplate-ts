# Database
# Get your pooled connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js secret required in all environments
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set this on Vercel or any custom domain so Auth.js generates the correct callback URLs
# Example: https://your-domain.com
AUTH_URL=

# Set to true when deploying behind Vercel or another trusted proxy
AUTH_TRUST_HOST=true

# Google OAuth create credentials at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
